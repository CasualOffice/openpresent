<?xml version="1.0" encoding="UTF-8"?>
<!-- opc-coreProperties.xsd imports Dublin Core from the network, and F4 has none. -->
<!-- wml.xsd imports the xml: namespace with no location; libxml2 looks the namespace up here (F4-04). -->
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">
  <uri name="http://www.w3.org/XML/1998/namespace" uri="w3c/xml.xsd"/>
  <system systemId="http://www.w3.org/2001/xml.xsd" uri="w3c/xml.xsd"/>
  <system systemId="http://dublincore.org/schemas/xmls/qdc/2003/04/02/dc.xsd" uri="dublin-core/dc.xsd"/>
  <system systemId="http://dublincore.org/schemas/xmls/qdc/2003/04/02/dcterms.xsd" uri="dublin-core/dcterms.xsd"/>
  <uri name="http://dublincore.org/schemas/xmls/qdc/2003/04/02/dc.xsd" uri="dublin-core/dc.xsd"/>
  <uri name="http://dublincore.org/schemas/xmls/qdc/2003/04/02/dcterms.xsd" uri="dublin-core/dcterms.xsd"/>
</catalog>
